## This file must *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the SDK. This is only used by Gradle.
# For customization when using a Version Control System, please read the
# header note.
#
# Examples:
# sdk.dir=/Users/username/Library/Android/sdk   (macOS)
# sdk.dir=/home/username/Android/Sdk           (Linux)
# sdk.dir=C\:\\Users\\username\\AppData\\Local\\Android\\Sdk (Windows)

sdk.dir=/path/to/Android/sdk

# Optional local testing IPTV credentials
iptv.host=http://your-provider.com:8080
iptv.username=your_username
iptv.password=your_password
